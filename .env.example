# Supabase configuration (safe to expose — protected by Row Level Security)
# Copy this file to ".env" and fill in your project's values.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: shared secret for the booking-notify edge function.
# Set the SAME value as the function's BOOKING_SECRET to block other callers.
VITE_BOOKING_SECRET=
